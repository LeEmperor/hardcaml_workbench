; Complete stock catalog and default window. This exact spec is embedded in the client.
((version 1)
 (id stock)
 (definitions
  (((key overview)
    (template ((version 1) (name Overview) (preset (overview))
     (views (((kind workspace-tabs) (hidden false) (geometry ((x 0) (y 0) (width 80) (height 1))))
             ((kind live-status) (hidden false) (geometry ((x 0) (y 0) (width 28) (height 7))))
              ((kind run-selector) (hidden false) (geometry ((x 0) (y 0) (width 80) (height 7))))
             ((kind stage-checklist) (hidden false) (geometry ((x 0) (y 0) (width 28) (height 10))))
