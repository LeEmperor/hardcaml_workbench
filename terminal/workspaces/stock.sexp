              ((kind synthesis) (hidden false) (geometry ((x 0) (y 0) (width 80) (height 10))))
             ((kind timing) (hidden false) (geometry ((x 0) (y 0) (width 80) (height 10))))
             ((kind placement) (hidden false) (geometry ((x 0) (y 0) (width 80) (height 10))))
             ((kind routing) (hidden false) (geometry ((x 0) (y 0) (width 80) (height 10))))
             ((kind checks) (hidden false) (geometry ((x 0) (y 0) (width 80) (height 10))))
             ((kind finalization) (hidden false) (geometry ((x 0) (y 0) (width 80) (height 10))))
             ((kind planned-run) (hidden false) (geometry ((x 0) (y 0) (width 80) (height 10))))
             ((kind resource-summary) (hidden false) (geometry ((x 0) (y 0) (width 28) (height 1))))))))
    (tiles (((key workspace-tabs) (presentation (((title (false)) (binding_badge (hidden)) (hints (false)) (frame (false)) (padding (0))))))
            ((key live-status))
             ((key run-selector) (presentation (((visible_rows (4))))))
            ((key stage-checklist) (presentation (((horizontal_stages (false)) (compact_summary (true)) (run_reference (false)) (hints (false))))))
             ((key preparation) (presentation (((run_reference (false)) (hints (false))))))
             ((key synthesis) (presentation (((compact_summary (true)) (run_reference (false)) (hints (false))))))
            ((key timing) (presentation (((compact_summary (true)) (run_reference (false)) (hints (false))))))
            ((key placement) (presentation (((compact_summary (true)) (run_reference (false)) (hints (false))))))
            ((key routing) (presentation (((compact_summary (true)) (run_reference (false)) (hints (false))))))
            ((key checks) (presentation (((compact_summary (true)) (run_reference (false)) (hints (false))))))
            ((key finalization) (presentation (((compact_summary (true)) (run_reference (false)) (hints (false))))))
             ((key planned-run) (presentation (((compact_summary (true)) (run_reference (false)) (hints (false))))))
             ((key resource-summary) (presentation (((title (false)) (frame (false)) (padding (0)) (binding_badge (hidden)) (run_reference (false)) (hints (false))))))))
    (layout ((Stack
      ((Leaf (tile workspace-tabs) (min_width 24) (min_height 1) (weight 0))
       (Weighted_columns
        ((1 (Stack ((Leaf (tile live-status) (min_width 24) (min_height 7) (weight 0))
                     (Leaf (tile run-selector) (min_width 24) (min_height 7) (weight 0))
                     (Leaf (tile resource-summary) (min_width 24) (min_height 1) (weight 0))
                    (Leaf (tile stage-checklist) (min_width 24) (min_height 10) (weight 1))
                    (Leaf (tile planned-run) (min_width 24) (min_height 10) (weight 1)))))
          (2 (Stack ((Leaf (tile preparation) (min_width 24) (min_height 7) (weight 0))
                     (Leaf (tile synthesis) (min_width 24) (min_height 5) (weight 1))
                    (Leaf (tile timing) (min_width 24) (min_height 5) (weight 1))
                    (Leaf (tile placement) (min_width 24) (min_height 5) (weight 1))
                    (Leaf (tile routing) (min_width 24) (min_height 5) (weight 1))
                    (Leaf (tile checks) (min_width 24) (min_height 5) (weight 1))
                    (Leaf (tile finalization) (min_width 24) (min_height 5) (weight 1))))))))))))
   ((key timing)
