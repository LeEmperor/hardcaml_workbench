# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "A local development workbench for independent Hardcaml projects"
description: """
A standalone native OCaml application for inspecting, running, measuring, and
debugging independently owned Hardcaml projects."""
maintainer: ["Bohdan Purtell <bohdanpurtell@gmail.com>"]
authors: ["Bohdan Purtell <bohdanpurtell@gmail.com>"]
homepage: "https://github.com/LeEmperor/hardcaml_workbench"
bug-reports: "https://github.com/LeEmperor/hardcaml_workbench/issues"
depends: [
  "dune" {>= "3.22"}
  "ocaml" {>= "5.1"}
  "core"
  "ppx_jane"
  "core_unix"
  "bonsai"
  "bonsai_term"
  "async"
  "cohttp-async"
  "cryptokit"
  "ppx_js_style" {with-dev-setup}
  "ocamlformat" {with-dev-setup}
  "ocaml-lsp-server" {with-dev-setup}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/LeEmperor/hardcaml_workbench.git"
x-maintenance-intent: ["(latest)"]
